APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key
APPWRITE_PUBLIC_BUCKET_ID=public_assets
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_SOURCE_PDFS_BUCKET_ID=source_pdfs
NEXT_PUBLIC_APPWRITE_PUBLIC_BUCKET_ID=public_assets
WORKER_API_URL=https://your-worker.example.com
WORKER_API_TOKEN=your_worker_bearer_token
# Optional. Ceiling on a single worker dispatch request (default 1200000 = 20 min).
# POST /jobs/ingest renders and publishes synchronously, so this MUST exceed the slowest
# real book. Node's built-in default is only 300s, which aborts healthy long ingests.
WORKER_REQUEST_TIMEOUT_MS=1200000
# Optional. Attempts before an unconfirmed dispatch is marked failed (default 3).
# Bounds the queue loop when the worker is unreachable or too slow.
WORKER_DISPATCH_MAX_ATTEMPTS=3
NEXT_PUBLIC_AI_QUICK_ANALYSIS_AS_JOB=false
NEXT_PUBLIC_AI_QUICK_ANALYSIS_MAX_PAGES=40
