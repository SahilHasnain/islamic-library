        { "key": "score", "type": "integer", "min": 0, "max": 100, "required": false },
        { "key": "position", "type": "integer", "min": 0, "max": 100, "required": true },
        { "key": "createdAt", "type": "datetime", "required": true },
        { "key": "updatedAt", "type": "datetime", "required": true }
