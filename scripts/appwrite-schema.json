        {
          "key": "manifestUrl",
          "type": "string",
          "size": 2048,
          "required": false
        },
        {
          "key": "metadataUrl",
          "type": "string",
          "size": 2048,
          "required": false
        },
        {
          "key": "coverImageUrl",
          "type": "string",
          "size": 2048,
          "required": false
        },
        {
          "key": "nextRecommendedBookId",
