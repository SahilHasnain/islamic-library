          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "createdAt",
          "type": "datetime",
          "required": true
        },
        {
          "key": "updatedAt",
          "type": "datetime",
          "required": true
        }
      ]
    },
    {
