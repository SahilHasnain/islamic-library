        { "key": "bookSlug", "type": "string", "size": 128, "required": true },
        { "key": "languageId", "type": "string", "size": 64, "required": true },
        { "key": "volumeId", "type": "string", "size": 64, "required": true },
        { "key": "entryId", "type": "string", "size": 128, "required": true },
