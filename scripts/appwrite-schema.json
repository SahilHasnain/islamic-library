        {
          "key": "slug",
          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "title",
          "type": "string",
          "size": 255,
          "required": true
        },
        {
          "key": "subtitle",
          "type": "string",
          "size": 255,
          "required": false
        },
        {
          "key": "author",
          "type": "string",
          "size": 255,
          "required": false
        },
        {
          "key": "description",
          "type": "string",
          "size": 5000,
          "required": false
        },
        {
          "key": "category",
          "type": "string",
          "size": 120,
          "required": false
        },
        {
          "key": "languageId",
          "type": "string",
          "size": 64,
          "required": true
