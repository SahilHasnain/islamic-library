          "required": false
        },
        {
          "key": "pushError",
          "type": "string",
          "size": 5000,
          "required": false
        },
        {
          "key": "pushAttempts",
          "type": "integer",
          "min": 0,
          "max": 100000,
          "required": false,
          "default": 0
