        {
          "key": "workerVersion",
          "type": "string",
          "size": 64,
          "required": false
        },
        {
          "key": "errorCode",
          "type": "string",
          "size": 128,
          "required": false
        },
        {
          "key": "errorMessage",
          "type": "string",
          "size": 5000,
          "required": false
        },
        {
          "key": "outputVersion",
          "type": "string",
          "size": 64,
          "required": false
        },
        {
          "key": "pageCount",
          "type": "integer",
          "min": 1,
          "max": 100000,
          "required": false
