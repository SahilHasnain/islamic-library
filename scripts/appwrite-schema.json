          "key": "jobId",
          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "bookSlug",
          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "sourceFileId",
          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "languageId",
          "type": "string",
          "size": 64,
          "required": true
        },
        {
          "key": "volumeId",
          "type": "string",
          "size": 64,
          "required": true
