APPWRITE_PROJECT_ID=your_project_id
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_API_KEY=your_server_api_key
APPWRITE_DATABASE_ID=library_ingestion
APPWRITE_JOBS_COLLECTION_ID=ingestion_jobs
APPWRITE_BOOKS_COLLECTION_ID=books
APPWRITE_SOURCE_BUCKET_ID=source_pdfs
APPWRITE_PUBLIC_BUCKET_ID=public_assets
WORKER_API_TOKEN=your_worker_bearer_token
WORKER_ID=vps-worker
WORKER_VERSION=v1
PORT=4010
MOCK_RENDER_ENABLED=true
MOCK_RENDER_PAGE_COUNT=6
MAX_RETRY_ATTEMPTS=3
# Appwrite Cloud sits behind Fastly, which resets connections past its concurrency
# ceiling (499 "Client Closed Request"). Keep page publishing in-flight below that.
APPWRITE_UPLOAD_CONCURRENCY=4
# Per-request budgets. Without these, calls fall through to undici's 300s default and a
# healthy multi-minute upload aborts and is reported as a plain "fetch failed".
APPWRITE_REQUEST_TIMEOUT_MS=120000
APPWRITE_UPLOAD_TIMEOUT_MS=600000
# Replays for 408/429/499/5xx and network errors. Safe: writes use deterministic IDs and
# uploads are delete-then-create overwrites.
APPWRITE_RETRY_ATTEMPTS=3
APPWRITE_RETRY_BASE_DELAY_MS=500
RENDER_DPI=144
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=
# Groq via OpenAI-compatible API:
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your_groq_api_key
# AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_BASE_URL=https://api.groq.com/openai/v1
# Ollama local OpenAI-compatible API:
# AI_PROVIDER=local
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5:3b
# AI_BASE_URL=http://localhost:11434/v1
AI_HTTP_REFERER=http://localhost:3000
AI_APP_TITLE=Islamic Library Admin
AI_ANALYSIS_MAX_PAGES=40
AI_ANALYSIS_CHUNK_PAGES=5
AI_ANALYSIS_CHUNK_DELAY_MS=5000
AI_PROVIDER_RETRY_ATTEMPTS=4
AI_PROVIDER_TIMEOUT_MS=180000
AI_PROMPT_TEXT_CHAR_LIMIT=18000
AI_MERGE_PROMPT_CHAR_LIMIT=18000
AI_QUICK_ANALYSIS_STRATEGY=toc-first
AI_EXTRACT_PREVIEW_PAGES=20
AI_EXTRACT_PREVIEW_CHARS_PER_PAGE=2500
# Quick analysis can infer full app sections from early TOC pages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
