# Mobile app (Expo) — public catalog delivery from the self-hosted Appwrite instance.
# Copy to .env.local and fill in after provisioning (appwrite:provision).
EXPO_PUBLIC_APPWRITE_ENDPOINT=http://35.200.174.46/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
EXPO_PUBLIC_APPWRITE_PUBLIC_BUCKET_ID=public_assets
EXPO_PUBLIC_APPWRITE_CATALOG_FILE_ID=catalog

# Optional: full catalog URL override (takes precedence over the assembled URL).
# EXPO_PUBLIC_LIBRARY_CATALOG_URL=